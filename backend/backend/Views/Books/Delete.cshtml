@model backend.Models.Book

<h2>Delete Book</h2>
<p>Are you sure you want to delete this book?</p>

<div>
    <strong>Title:</strong> @Model.Title <br />
    <strong>Author:</strong> @Model.Author <br />
    <strong>Publisher:</strong> @Model.Publisher <br />
    <strong>Category:</strong> @Model.Category <br />
    <strong>Price:</strong> $@Model.Price
</div>

<form method="post" asp-action="Delete">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
</form>
